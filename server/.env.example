MONGO_URI=mongodb://127.0.0.1:27017/hospiq
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
HOSPITAL_TIMEZONE=Asia/Dubai
PORT=5000
EMAIL_USER=
EMAIL_PASS=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# 64 hex characters (32 random bytes); back up separately from stored files
MEDICAL_FILE_KEY=
# Optional absolute path to a private persistent volume (default: server/storage/medical)
MEDICAL_STORAGE_DIR=

# Optional SMTP transport URL (for another provider or local mail sandbox); otherwise Gmail is used
SMTP_URL=

# Optional initial password for a new large fictional dataset; existing passwords are never reset
LARGE_DEMO_PASSWORD=

# Stripe hosted pharmacy checkout (AED). Leave blank for counter payments only.
# Use test-mode keys for development; never expose these through VITE_* variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional one-time first Hospiq Admin bootstrap (not needed for seeded demos).
# Remove these from your environment after bootstrap; passwords are never logged.
HOSPIQ_ADMIN_EMAIL=
HOSPIQ_ADMIN_PASSWORD=

# Optional local OCR; no document is sent to an external provider.
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# OCR_LANGUAGES=eng+ara

# Optional structured request timing logs; excludes query strings, bodies and credentials
LOG_REQUESTS=false

# Required in production. All replicas must use the same Redis store and JWT secret.
REDIS_URL=
# Optional comma-separated addresses/CIDRs of the actual trusted reverse proxies.
TRUSTED_PROXY_CIDRS=
# Production always screens passwords. Opt in for a local environment.
CHECK_BREACHED_PASSWORDS=false
